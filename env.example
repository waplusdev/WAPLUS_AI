# ── WaPlus ─────────────────────────────────────────────
BOT_NAME=WaPlus
BOT_VERSION=2.0.0
BOT_DESCRIPTION=Developer-first WhatsApp bot framework
BOT_FOOTER=Powered by WaPlus
OWNER_NAME=Your Name
OWNER_NUMBER=2348012345678
PREFIX=.
# PREFIXES=.,!,#

# Pairing
REQUEST_PAIRING=true
# PAIRING_NUMBER=2348012345678
SESSION_NAME=sessions

# Runtime
PUBLIC_MODE=true
AUTO_READ=false
AUTO_TYPING=false
PORT=3001
LOG_LEVEL=silent
COMMAND_COOLDOWN_MS=1000
MAX_MEDIA_BYTES=15000000

# AI: gemini or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_SYSTEM_PROMPT=You are WaPlus AI, a helpful concise WhatsApp assistant.
# CHATBOT_MODE=private
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# GitHub (owner-only commands)
GITHUB_TOKEN=
GITHUB_OWNER=

# Optional authorized media adapter
MEDIA_API_URL=
